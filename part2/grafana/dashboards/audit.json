          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.4.14",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-audit"
          },
          "expr": "100 * (1 - sum by (machine) (rate(audit_cpu_ticks_total{machine=~\"$machine\", mode=\"idle\"}[$__rate_interval])) / sum by (machine) (rate(audit_cpu_ticks_total{machine=~\"$machine\"}[$__rate_interval])))",
